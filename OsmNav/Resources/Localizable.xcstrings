    "Achtung: Offline-Pakete gibt es nur für die Vektorkarte (MapLibre) — die OSM-Karte bleibt offline leer. Oben „MapLibre“ wählen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Offline-Pakete gibt es nur für die Vektorkarte (MapLibre) — die OSM-Karte bleibt offline leer. Oben „MapLibre“ wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: offline packs only work with the vector map (MapLibre) — the OSM map stays empty offline. Choose “MapLibre” above."
          }
        }
      }
    },
