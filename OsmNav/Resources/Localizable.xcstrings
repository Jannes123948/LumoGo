    "Der Parkplatz wird automatisch gemerkt, wenn du mit dem Auto am Ziel ankommst (oder die Navigation kurz davor beendest). Fährst du am Auto los, wird er wieder vergessen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Parkplatz wird automatisch gemerkt, wenn du mit dem Auto am Ziel ankommst (oder die Navigation kurz davor beendest). Fährst du am Auto los, wird er wieder vergessen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
