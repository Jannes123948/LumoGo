          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert ohne Einrichtung, auch in der Kurzbefehle-App. Widget: Homescreen lange drücken → „+“ → LumoGo (auch für den Sperrbildschirm). „Nach Hause“ braucht ein gespeichertes Zuhause in den Favoriten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works without setup, also in the Shortcuts app. Widget: long-press the Home Screen → “+” → LumoGo (also for the Lock Screen). “Home” needs a saved home in your favorites."
          }
        }
      }
    },
